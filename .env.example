# Copy this file to .env and fill in your values.
# .env is gitignored and must NEVER be committed.

# Anthropic / Claude API
ANTHROPIC_API_KEY=

# NBA API (if using a paid tier or proxy)
NBA_API_KEY=

# Optional: proxy for stats.nba.com requests
NBA_STATS_PROXY=

# Optional: override default alert threshold (default: 65)
COMEBACK_ALERT_PCT=
